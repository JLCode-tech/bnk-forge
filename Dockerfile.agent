# Dockerfile.agent — slim image for the built-in Forge benchmark agent.
#
# Runs scripts/forge_agent.py: self-registers with Forge, connects via
# WebSocket, and executes aiperf benchmark runs on demand.
#
# Build:  make build-agent
# Deploy: included in docker-compose.yml as the `forge-agent` service.

FROM python:3.11-slim

# Install aiperf + websockets + requests.
# aiperf pulls in `crick` (a C-extension stats lib) which compiles from source,
# so build tooling (gcc) is needed at install time; purge it afterwards to keep
# the image slim. aiperf is pinned: Forge ingest is verified against this
# export format, and an unpinned rebuild silently changes it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential openssh-client curl unzip \
    && pip install --no-cache-dir \
        aiperf==0.13.0 \
        websockets \
        requests \
    && ARCH=$(uname -m) \
    && if [ "$ARCH" = "x86_64" ]; then AWS_ARCH="x86_64"; else AWS_ARCH="aarch64"; fi \
    && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${AWS_ARCH}.zip" -o "/tmp/awscliv2.zip" \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/aws /tmp/awscliv2.zip \
    && apt-get purge -y --auto-remove build-essential curl unzip \
    && rm -rf /var/lib/apt/lists/*

# Non-root user for security
RUN useradd -m -u 1001 -s /bin/bash forgeagent

WORKDIR /app

COPY scripts/forge_agent.py /app/forge_agent.py
COPY scripts/forge_agent_runner.py /app/forge_agent_runner.py

RUN chown -R forgeagent:forgeagent /app

USER forgeagent

# Runtime configuration via env vars:
#   FORGE_URL          — Forge backend URL (required)
#   AGENT_NAME         — agent name shown in the UI (default: forge-local)
#   AGENT_TOKEN        — JWT bearer token (optional; only needed when
#                        BENCHMARK_AGENT_AUTH_REQUIRED is enabled on the server)
#   AGENT_TOKEN_FILE   — Path to token file (default: /run/forge/builtin_agent.token)
#   AGENT_ADVERTISE_IP — IP to report; override if socket resolution is wrong
ENTRYPOINT ["python", "/app/forge_agent_runner.py"]
